<Project Sdk="Godot.NET.Sdk/4.5.1">
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <LangVersion>12.0</LangVersion>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- 改成你的杀戮尖塔2目录 -->
        <Sts2Dir>D:\Game\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        
        <RitsuLibDeployDir>$(Sts2Dir)/mods/STS2-RitsuLib/</RitsuLibDeployDir>
        <FmodBuildDir>C:\Users\13954\Downloads\STS2_FModProject_Minimal-main\STS2_FModProject_Minimal-main\Build</FmodBuildDir>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)\sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>

        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)\Steamworks.NET.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="STS2-RitsuLib">
            <HintPath>$(Sts2Dir)/mods/RitsuLib/STS2-RitsuLib.dll</HintPath>
            <Private>false</Private>
        </Reference>

    </ItemGroup>
    <ItemGroup>
        <Compile Remove="教程文件\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="*" />
        <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="Godot\Character\Liver\layer4.png" />
      <Content Include="Godot\Character\Liver\LiverRest.tscn" />
      <Content Include="Godot\CombatUI\resource\WorkLevel.png" />
      <Content Include="Godot\CombatUI\resource\WorkLevelLock.png" />
      <Content Include="Godot\CombatUI\resource\WorkLevelLock2.png" />
      <Content Include="Godot\CombatUI\Test.tcsn" />
      <Content Include="Godot\Encouters\bg.png" />
      <Content Include="Godot\Encouters\bg.png.import" />
      <Content Include="Godot\Encouters\mushroomEncounterBg.tcsn" />
      <Content Include="Godot\RestSiteAnim\liver_merchant.tscn" />
      <Content Include="Godot\RestSiteAnim\Liver_rest_site.tscn" />
      <Content Include="Resource\Card\CardSkill1024.png" />
      <Content Include="Resource\SlugCat\card_orb.png" />
      <Content Include="Resource\SlugCat\Head.svg" />
      <Content Include="Resource\SlugCat\Head.png" />
      <Content Include="Resource\SlugCat\Liver_Select_Button.png" />
      <Content Include="Resource\SlugCat\small_orb.png" />
      <Content Include="Resource\Sound\GUIDs.txt" />
      <Content Include="Resource\Sound\SlugcatTheSpireII.bank" />
      <Content Include="SlugcatTheSpireII\localization\eng\encounters.json" />
      <Content Include="SlugcatTheSpireII\localization\eng\events.json" />
      <Content Include="SlugcatTheSpireII\localization\eng\monsters.json" />
      <Content Include="SlugcatTheSpireII\localization\eng\static_hover_tips.json" />
      <Content Include="SlugcatTheSpireII\localization\kor\encounters.json" />
      <Content Include="SlugcatTheSpireII\localization\kor\events.json" />
      <Content Include="SlugcatTheSpireII\localization\kor\monsters.json" />
      <Content Include="SlugcatTheSpireII\localization\kor\static_hover_tips.json" />
      <Content Include="SlugcatTheSpireII\localization\zhs\enchantments.json" />
      <Content Include="SlugcatTheSpireII\localization\zhs\encounters.json" />
      <Content Include="SlugcatTheSpireII\localization\zhs\events.json" />
      <Content Include="SlugcatTheSpireII\localization\zhs\monsters.json" />
