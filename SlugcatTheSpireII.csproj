    <ItemGroup>
      <Folder Include="Godot\Monster\" />
      <Folder Include="Scripts\Card\Monk\Orders\" />
      <Folder Include="Scripts\Card\Temp\" />
      <Folder Include="Scripts\Enchantments\" />
      <Folder Include="Scripts\Test\" />
    </ItemGroup>

    <!-- 自动复制dll -->
    <!-- 自动复制dll和FMOD音频 -->
    <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
        <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
        <MakeDir Directories="$(Sts2Dir)\mods\" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2Dir)\mods\$(MSBuildProjectName)\" />
        <Message Text="Copying FMOD bank and GUIDs..." Importance="high" />
        <Copy SourceFiles="$(FmodBuildDir)\desktop\SlugcatTheSpireII.bank" DestinationFolder="Resource\Sound\" />
        <Copy SourceFiles="$(FmodBuildDir)\GUIDs.txt" DestinationFolder="Resource\Sound\" />
    </Target>
</Project>